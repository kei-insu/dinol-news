---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import ArchiveCta from '../components/ArchiveCta.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Scripts from '../components/Scripts.astro';
const { pageTitle, description, canonical, ogType, ogImage, jsonLd, siteDate } = Astro.props;
---
<!DOCTYPE html>
<html lang="ko">
<head><Head
  pageTitle={pageTitle}
  description={description}
  canonical={canonical}
  ogType={ogType}
  ogImage={ogImage}
  jsonLd={jsonLd}
/></head>
<body>
<Header siteDate={siteDate} />
<slot />
<ArchiveCta />
<SiteFooter />
<Scripts />
</body>
</html>
