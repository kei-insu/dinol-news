---
const { card } = Astro.props;
const d = card.source.publishedAt;
const dateStr = d ? d.split('-').join('. ') : '';
const src = card.source.name ? `${card.source.name} · ${dateStr}` : dateStr;
const isEn = card.isEn;
const attrs = {
  'data-category': card.category.kr,
  'data-summary': isEn ? card.summary.en : card.summary.kr,
  'data-points': (isEn ? card.points.en : card.points.kr).join('|'),
  'data-designer': isEn ? card.designer.en : card.designer.kr,
  'data-impact-score': String(card.impactScore),
  'data-recommend': isEn ? card.recommend.en : card.recommend.kr,
  'data-comment': isEn ? card.comment.en : card.comment.kr,
};
if (isEn) {
  attrs['data-summary-kr']   = card.summary.kr;
  attrs['data-points-kr']    = card.points.kr.join('|');
  attrs['data-designer-kr']  = card.designer.kr;
  attrs['data-recommend-kr'] = card.recommend.kr;
  attrs['data-comment-kr']   = card.comment.kr;
  attrs['data-title-en']     = card.title.en;
}
for (const k of Object.keys(attrs)) if (attrs[k] == null) delete attrs[k];
---
<a class={card.featured ? 'card featured' : 'card'} href={card.url} target="_blank" {...attrs}>
  <div class={`thumb ${card.thumbGradient}`}>
    <div class="noise"></div>
    <span class="thumb-label">{card.thumbLabel}</span>
    {isEn && <span class="thumb-en">EN</span>}
  </div>
  <div class="card-body">
    <div class="card-source">{src}</div>
    <div class="card-title">{card.title.kr}</div>
  </div>
  <div class="card-footer"><div class="card-actions"><span class="act act-like" role="button" aria-label="좋아요"><svg viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg><span class="act-count"></span></span><span class="act act-share" role="button" aria-label="공유"><svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg></span></div></div>
</a>
