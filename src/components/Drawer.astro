<!-- ── DRAWER ── -->
<div class="drawer-overlay" id="drawerOverlay"></div>
<div class="drawer" id="drawer">
  <div class="drawer-header">
    <div class="drawer-source" id="drawerSource"></div>
  </div>
  <div class="drawer-thumb" id="drawerThumb">
    <div class="noise"></div>
    <span class="thumb-label" id="drawerLabel"></span>
    <span class="thumb-en" id="drawerEn" style="display:none">EN</span>
  </div>
  <div class="drawer-body">
    <div class="drawer-toolbar">
      <div class="card-actions drawer-actions">
        <span class="act act-like" id="drawerLike" role="button" aria-label="좋아요"><svg viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg><span class="act-count" id="drawerLikeCount"></span></span>
        <span class="act act-share" id="drawerShare" role="button" aria-label="공유"><svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg></span>
      </div>
      <div class="drawer-lang-toggle" id="drawerLangToggle" style="display:none">
        <button class="lang-btn active" id="btnKr">KR</button>
        <button class="lang-btn" id="btnEn">EN</button>
      </div>
    </div>
    <div class="drawer-category" id="drawerCategory"></div>
    <div class="drawer-title" id="drawerTitle"></div>

    <div class="drawer-field">
      <div class="drawer-field-label">한 줄 요약</div>
      <div class="drawer-field-text" id="drawerOneline"></div>
    </div>
    <div class="drawer-field">
      <div class="drawer-field-label">핵심 인사이트</div>
      <ul class="drawer-points" id="drawerPoints"></ul>
    </div>
    <div class="drawer-field">
      <div class="drawer-field-label">디자이너 관점</div>
      <div class="drawer-field-text" id="drawerDesigner"></div>
    </div>
    <div class="drawer-field">
      <div class="drawer-field-label">실무 영향도</div>
      <div class="drawer-stars" id="drawerImpact"></div>
    </div>
    <div class="drawer-field">
      <div class="drawer-field-label">활용 추천</div>
      <div class="drawer-field-text" id="drawerRecommend"></div>
    </div>
    <div class="drawer-comment" id="drawerCommentWrap">
      <div class="drawer-comment-label">💬 큐레이션 노트</div>
      <div class="drawer-comment-text" id="drawerComment"></div>
    </div>
  </div>
  <div class="drawer-footer">
    <button class="drawer-close-btn" id="drawerClose">닫기</button>
    <a class="drawer-cta" id="drawerCta" target="_blank" rel="noopener">원문 보기 →</a>
  </div>
</div>

