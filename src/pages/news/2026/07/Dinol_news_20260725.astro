---
import { getCollection } from 'astro:content';
import Briefing from '../../../../layouts/Briefing.astro';
import Section from '../../../../components/Section.astro';
import Card from '../../../../components/Card.astro';
const all = await getCollection('news');
const day = all.filter(c => c.data.date === '2026-07-25');
const ai = day.filter(c => c.data.section === 'ai').sort((a,b) => a.data.order - b.data.order);
const design = day.filter(c => c.data.section === 'design').sort((a,b) => a.data.order - b.data.order);
---
<Briefing titleDate="2026. 07. 25" siteDate="July 25, 2026">
  <Section name="AI">
    {ai.map(c => <Card card={c.data} />)}
  </Section>
  <Section name="Design">
    {design.map(c => <Card card={c.data} />)}
  </Section>
</Briefing>
