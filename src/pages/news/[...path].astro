---
import { getCollection } from 'astro:content';
import BriefingPage from '../../components/pages/BriefingPage.astro';
import DetailPage from '../../components/pages/DetailPage.astro';

export async function getStaticPaths() {
  const all = await getCollection('news');
  const dates = [...new Set(all.map(c => c.data.date))].sort();

  const briefings = dates.map(date => {
    const [y, m, d] = date.split('-');
    const day = all.filter(c => c.data.date === date);
    return {
      params: { path: `${y}/${m}/Dinol_news_${y}${m}${d}` },
      props: {
        kind: 'briefing', date,
        ai: day.filter(c => c.data.section === 'ai').sort((a,b)=>a.data.order-b.data.order),
        design: day.filter(c => c.data.section === 'design').sort((a,b)=>a.data.order-b.data.order),
      },
    };
  });

  const details = all.map(entry => {
    const [y, m] = entry.data.date.split('-');
    return {
      params: { path: `${y}/${m}/${entry.data.contentId}` },
      props: { kind: 'detail', card: entry.data },
    };
  });

  return [...briefings, ...details];
}
const props = Astro.props;
---
{props.kind === 'briefing'
  ? <BriefingPage date={props.date} ai={props.ai} design={props.design} />
  : <DetailPage card={props.card} />}
