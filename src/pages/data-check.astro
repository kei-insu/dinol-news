---
import { getCollection } from 'astro:content';
const all = await getCollection('news');
const byDate = new Map();
for (const c of all) {
  const d = c.data.date;
  byDate.set(d, (byDate.get(d) || 0) + 1);
}
const dates = [...byDate.keys()].sort();
const ai = all.filter(c => c.data.section === 'ai').length;
const design = all.filter(c => c.data.section === 'design').length;
const withPos = all.filter(c => c.data.positions.length > 0).length;
const scores = {};
for (const c of all) scores[c.data.impactScore] = (scores[c.data.impactScore] || 0) + 1;
const sample = all.find(c => c.data.contentId === '20260725-design-003');
---
<html><body style="font-family:monospace">
<h1>data check</h1>
<p>총 카드: {all.length}</p>
<p>AI {ai} / Design {design}</p>
<p>날짜 수: {dates.length} ({dates[0]} ~ {dates[dates.length-1]})</p>
<p>직무 부여: {withPos}</p>
<p>별점 분포: {JSON.stringify(scores)}</p>
<h2>샘플 20260725-design-003</h2>
<pre>{JSON.stringify(sample?.data, null, 2)}</pre>
</body></html>
